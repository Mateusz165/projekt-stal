# Baza danych PostgreSQL (Neon: https://neon.tech — darmowy tier)
# 1. Utwórz konto na neon.tech
# 2. Utwórz projekt → skopiuj "Connection string" (pooled)
DATABASE_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Sekrety JWT / auth
ADMIN_SECRET="zmien-na-losowy-string-min-32-znaki"
# Hasło startowe admina (używane tylko podczas npm run db:seed)
ADMIN_INITIAL_PASSWORD="zmien-na-silne-haslo"
NEXTAUTH_SECRET="zmien-na-losowy-string-min-32-znaki"
NEXTAUTH_URL="https://twoja-domena.pl"

# E-mail (SMTP)
# Gmail: włącz "Hasła aplikacji" w ustawieniach konta Google (myaccount.google.com/security)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="projekt.stalbialystok@gmail.com"
SMTP_PASS="xxxx-xxxx-xxxx-xxxx"  # hasło aplikacji Gmail (16 znaków)
ADMIN_EMAIL="projekt.stalbialystok@gmail.com"

# Stripe (sklep internetowy)
# Testowe klucze: https://dashboard.stripe.com/test/apikeys
# Produkcyjne: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."  # po uruchomieniu: stripe listen --forward-to localhost:3000/api/webhooks/stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# URL strony (bez trailing slash)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Google Analytics GA4
# analytics.google.com → Admin → Data Streams → Measurement ID (G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# Vercel Blob (zdjęcia w panelu admina)
# Vercel Dashboard → Storage → Create Blob Store → skopiuj BLOB_READ_WRITE_TOKEN
# Lokalnie bez tego tokenu zdjęcia zapisują się do public/uploads/ (tylko dev)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
